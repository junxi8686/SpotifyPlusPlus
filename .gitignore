# Build output and tooling caches
build/
.gradle/
*.iml
.idea/
captures/

# Version-stamped debug APKs the build copies out of build/ for convenient installs.
# They are build output, not source, so they stay out of history.
artifacts/

# Machine-specific SDK location
local.properties

# Keystores and signing material - never commit these
*.jks
*.keystore
keystore.properties

# OS noise
.DS_Store
Thumbs.db
