<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android Auto support needs to see the head-unit app to bind/publish the prototype surface,
         and Spotify itself to resolve the hooked process. See auto/AndroidAutoResolver. -->
    <queries>
        <package android:name="com.spotify.music"/>
        <package android:name="com.google.android.projection.gearhead"/>
    </queries>

    <!-- Pure Xposed/LSPosed module: no launcher activity, no IPC. Settings live entirely inside the
         Spotify hook (the ⚙ panel writes Spotify-side prefs the hook reads directly), so this works
         under both LSPosed and LSPatch with no separate app. -->
    <application
            android:allowBackup="true"
            android:fullBackupContent="@xml/backup_rules"
            tools:targetApi="31"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:description="@string/module_description"
            android:supportsRtl="true">
        <!-- Optional Android Auto prototype transport. Both entries are inert unless the module is
             enabled for the head-unit app; they exist so the hooked Spotify process can publish the
             current lyric row without persisting any lyric text. -->
        <service android:name="com.spotifyplusplus.auto.AutoPrototypeService" android:exported="true"/>
        <provider android:name="com.spotifyplusplus.auto.AutoPrototypeProvider"
            android:authorities="com.spotifyplusplus.autoprototype" android:exported="true" android:grantUriPermissions="true"/>
    </application>

</manifest>
